<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="15.0" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gap.controller.SincronizacaoController"
      prefWidth="760.0">

    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
    </padding>

    <!-- Título -->
    <Label text="Sincronização com Equipamentos">
        <font>
            <Font name="System Bold" size="18.0" />
        </font>
    </Label>

    <Label text="Envia todas as pessoas cadastradas para todos os equipamentos. Registros existentes são atualizados automaticamente."
           textFill="#606060" wrapText="true" />

    <!-- Barra de progresso -->
    <VBox spacing="5.0">
        <Label fx:id="lblProgresso" text="Aguardando..." />
        <ProgressBar fx:id="barraProgresso" progress="0.0" prefWidth="Infinity" prefHeight="20.0" />
    </VBox>

    <!-- Log em tempo real -->
    <TextArea fx:id="areaLog"
              editable="false"
              prefHeight="350.0"
              style="-fx-font-family: 'Monospaced'; -fx-font-size: 12;"
              wrapText="true"
              VBox.vgrow="ALWAYS" />

    <!-- Botões -->
    <HBox spacing="10.0">
        <Button fx:id="btnSincronizar"
                onAction="#handleSincronizar"
                text="▶  Sincronizar Agora"
                prefWidth="180.0"
                style="-fx-base: #1565c0;"
                textFill="WHITE" />

        <Button fx:id="btnFechar"
                onAction="#handleFechar"
                text="Fechar"
                prefWidth="100.0" />
    </HBox>

</VBox>
