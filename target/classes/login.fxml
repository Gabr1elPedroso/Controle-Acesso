<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="400.0" spacing="20.0" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.gap.controller.LoginController">
   <padding>
      <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
   </padding>
   
   <Label text="EcoTech - Acesso" textFill="#2E7D32">
      <font>
         <Font name="System Bold" size="24.0" />
      </font>
   </Label>
   
   <Label text="Insira suas credenciais para continuar" textFill="#666666" />
   
   <VBox spacing="5.0">
      <Label text="Usuário:" />
      <TextField fx:id="campoUsuario" promptText="Ex: admin" />
   </VBox>
   
   <VBox spacing="5.0">
      <Label text="Senha:" />
      <PasswordField fx:id="campoSenha" promptText="••••••••" />
   </VBox>
   
   <Button fx:id="btnLogin" maxWidth="Infinity" prefHeight="35.0" style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-font-weight: bold;" text="ENTRAR" />
   
   <Label fx:id="labelErro" text="Usuário ou senha incorretos!" textFill="RED" visible="false" />
</VBox>