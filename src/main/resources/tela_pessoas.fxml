<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="900.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://fxml.org/javafx/1" fx:controller="com.gap.controller.PessoaController">
   
   <!-- Lado Esquerdo: Tabela de Pessoas e Busca -->
   <left>
      <VBox prefWidth="380.0" spacing="15.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-width: 0 1 0 0;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
         
         <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label text="Pessoas" textFill="#0F172A">
               <font>
                  <Font name="System Bold" size="20.0" />
               </font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnNovo" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-background-radius: 6;" text="+ Novo Usuário">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
            </Button>
         </HBox>
         
         <TextField fx:id="campoBusca" promptText="🔍 Pesquisar por nome ou matrícula..." style="-fx-background-radius: 6; -fx-padding: 8;" />
         
         <TableView fx:id="tabelaPessoas" prefHeight="550.0" VBox.vgrow="ALWAYS">
            <columns>
               <TableColumn fx:id="colunaNome" prefWidth="220.0" text="Nome" />
               <TableColumn fx:id="colunaMatricula" prefWidth="118.0" text="Matrícula" />
            </columns>
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
         </TableView>
      </VBox>
   </left>
   
   <!-- Lado Direito: Formulário de Cadastro/Edição -->
   <center>
      <VBox fx:id="painelFormulario" spacing="15.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
         </padding>
         
         <Label text="Detalhes do Cadastro" textFill="#0F172A">
            <font>
               <Font name="System Bold" size="18.0" />
            </font>
         </Label>
         
         <!-- Área da Foto de Perfil -->
         <HBox alignment="CENTER_LEFT" spacing="20.0">
            <VBox alignment="CENTER" prefHeight="110.0" prefWidth="110.0" style="-fx-border-color: #CBD5E1; -fx-border-radius: 8; -fx-background-color: #F1F5F9; -fx-background-radius: 8;">
               <ImageView fx:id="fotoPerfil" fitHeight="100.0" fitWidth="100.0" pickOnBounds="true" preserveRatio="true" />
            </VBox>
            
            <VBox alignment="CENTER_LEFT" spacing="10.0">
               <Label text="Foto Facial (Reconhecimento)" textFill="#64748B">
                  <font>
                     <Font size="12.0" />
                  </font>
               </Label>
               <Button fx:id="btnEscolherFoto" style="-fx-background-color: #E2E8F0; -fx-text-fill: #1E293B; -fx-background-radius: 6;" text="📸 Selecionar Foto" />
            </VBox>
         </HBox>
         
         <!-- Form Fields -->
         <VBox spacing="5.0">
            <Label text="Nome Completo *" textFill="#334155">
               <font><Font name="System Bold" size="12.0" /></font>
            </Label>
            <TextField fx:id="campoNome" promptText="Ex: João da Silva" style="-fx-background-radius: 6; -fx-padding: 8;" />
         </VBox>
         
         <HBox spacing="15.0">
            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
               <Label text="Matrícula / ID *" textFill="#334155">
                  <font><Font name="System Bold" size="12.0" /></font>
               </Label>
               <TextField fx:id="campoMatricula" promptText="Ex: 1024" style="-fx-background-radius: 6; -fx-padding: 8;" />
            </VBox>
            
            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
               <Label text="Categoria *" textFill="#334155">
                  <font><Font name="System Bold" size="12.0" /></font>
               </Label>
               <ComboBox fx:id="comboCategoria" maxWidth="Infinity" promptText="Selecione..." style="-fx-background-radius: 6; -fx-padding: 4;" />
            </VBox>
         </HBox>
         
         <!-- Permissões / Acesso a Equipamentos -->
         <Label text="Permissões de Acesso aos Equipamentos" textFill="#0F172A">
            <font>
               <Font name="System Bold" size="14.0" />
            </font>
            <VBox.margin>
               <Insets top="10.0" />
            </VBox.margin>
         </Label>
         
         <VBox fx:id="listaEquipamentos" prefHeight="120.0" spacing="8.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-radius: 6; -fx-background-radius: 6;">
            <padding>
               <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <children>
               <Label text="Nenhum equipamento cadastrado no momento." textFill="#94A3B8" />
            </children>
         </VBox>
         
         <!-- Botões de Ação na parte Inferior -->
         <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <VBox.margin>
               <Insets top="15.0" />
            </VBox.margin>
            <Button fx:id="btnExcluir" style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-background-radius: 6;" text="Excluir">
               <padding>
                  <Insets bottom="8.0" left="16.0" right="16.0" top="8.0" />
               </padding>
            </Button>
            <Button fx:id="btnSalvar" style="-fx-background-color: #16A34A; -fx-text-fill: white; -fx-background-radius: 6;" text="Salvar Cadastro">
               <font>
                  <Font name="System Bold" size="12.0" />
               </font>
               <padding>
                  <Insets bottom="8.0" left="20.0" right="20.0" top="8.0" />
               </padding>
            </Button>
         </HBox>
         
      </VBox>
   </center>
   
</BorderPane>