<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0" prefWidth="900.0" style="-fx-background-color: #F8FAFC;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://fxml.org/javafx/1" fx:controller="com.gap.controller.EquipamentoController">
   
   <center>
      <VBox spacing="15.0" style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-width: 0 1 0 0;" BorderPane.alignment="CENTER">
         <padding><Insets bottom="20.0" left="20.0" right="20.0" top="20.0" /></padding>
         
         <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label text="Equipamentos (Faciais / Catracas)" textFill="#0F172A">
               <font><Font name="System Bold" size="20.0" /></font>
            </Label>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnNovoEquipamento" style="-fx-background-color: #2563EB; -fx-text-fill: white; -fx-background-radius: 6;" text="+ Novo Equipamento">
               <font><Font name="System Bold" size="12.0" /></font>
            </Button>
         </HBox>
         
         <TableView fx:id="tabelaEquipamentos" prefHeight="550.0" VBox.vgrow="ALWAYS">
            <columns>
               <TableColumn fx:id="colunaNomeEquip" prefWidth="250.0" text="Nome do Dispositivo" />
               <TableColumn fx:id="colunaIp" prefWidth="200.0" text="Endereço IP" />
            </columns>
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
         </TableView>
      </VBox>
   </center>
   
   <right>
      <VBox fx:id="painelFormularioEquip" prefWidth="400.0" spacing="15.0" style="-fx-background-color: #F8FAFC;" BorderPane.alignment="CENTER">
         <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0" /></padding>
         
         <Label text="Detalhes do iDFace" textFill="#0F172A">
            <font><Font name="System Bold" size="18.0" /></font>
         </Label>
         
         <VBox spacing="5.0">
            <Label text="Nome (Localização) *" textFill="#334155"><font><Font name="System Bold" size="12.0" /></font></Label>
            <TextField fx:id="campoNomeEquip" promptText="Ex: Catraca Principal" style="-fx-background-radius: 6; -fx-padding: 8;" />
         </VBox>
         
         <HBox spacing="10.0">
            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
               <Label text="Endereço IP *" textFill="#334155"><font><Font name="System Bold" size="12.0" /></font></Label>
               <TextField fx:id="campoIp" promptText="Ex: 192.168.0.100" style="-fx-background-radius: 6; -fx-padding: 8;" />
            </VBox>
            
            <VBox spacing="5.0" prefWidth="100.0">
               <Label text="Porta *" textFill="#334155"><font><Font name="System Bold" size="12.0" /></font></Label>
               <TextField fx:id="campoPorta" text="80" style="-fx-background-radius: 6; -fx-padding: 8;" />
            </VBox>
         </HBox>

         <HBox spacing="10.0">
             <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                 <Label text="Usuário (API)" textFill="#334155"><font><Font name="System Bold" size="12.0" /></font></Label>
                 <TextField fx:id="campoUsuario" text="admin" style="-fx-background-radius: 6; -fx-padding: 8;" />
             </VBox>
             <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                 <Label text="Senha (API)" textFill="#334155"><font><Font name="System Bold" size="12.0" /></font></Label>
                 <PasswordField fx:id="campoSenha" text="admin" style="-fx-background-radius: 6; -fx-padding: 8;" />
             </VBox>
         </HBox>
         
         <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <VBox.margin><Insets top="15.0" /></VBox.margin>
            <Button fx:id="btnExcluirEquip" style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-background-radius: 6;" text="Excluir" />
            <Button fx:id="btnSalvarEquip" style="-fx-background-color: #16A34A; -fx-text-fill: white; -fx-background-radius: 6;" text="Salvar Dispositivo" />
         </HBox>
      </VBox>
   </right>
</BorderPane>